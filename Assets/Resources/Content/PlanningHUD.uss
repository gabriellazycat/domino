/* GDD §14.1: tokens. Fundo #2B1D14, painel #3C2A1E, texto #F4E7D0, destaque #F28C28. */
.hud-root { flex-grow: 1; }
.top-left {
  position: absolute; top: 16px; left: 16px;
  background-color: #3c2a1e; border-radius: 12px;
  padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px;
}
.objective { font-size: 28px; color: #f4e7d0; }
.msg { font-size: 20px; color: #f28c28; }
.bottom-bar {
  position: absolute; bottom: 16px; left: 0; right: 0;
  flex-direction: row; justify-content: center;
  background-color: #2b1d14;
  padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;
}
.tray-btn, .tool-btn {
  font-size: 20px; color: #f4e7d0; background-color: #3c2a1e;
  border-radius: 12px; margin-left: 4px; margin-right: 4px;
  padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px;
}
.tray-btn.selected {
  background-color: #f28c28; color: #2b1d14;
}
.tray-btn:disabled, .tool-btn:disabled, .fire-btn:disabled {
  opacity: 0.45;
}
.pulse {
  border-left-width: 3px; border-right-width: 3px;
  border-top-width: 3px; border-bottom-width: 3px;
  border-color: #ffd23f;
}
.danger { color: #e05a4e; }
.tray {
  flex-direction: row;
  max-width: 900px;
}
.actions { flex-direction: row; align-items: center; }
.tool-btn.on {
  background-color: #4f9dde; color: #2b1d14;
}
.fire-btn {
  font-size: 20px; color: #2b1d14; background-color: #f28c28;
  border-radius: 12px; margin-left: 8px;
  padding-left: 24px; padding-right: 24px; padding-top: 8px; padding-bottom: 8px;
}
.banner {
  position: absolute; top: 40%; left: 30%; right: 30%;
  background-color: #3c2a1e; border-radius: 12px;
  padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px;
  align-items: center;
}
.result-text { font-size: 28px; color: #f4e7d0; }
.hidden { display: none; }

/* Cartas (draft/loja, clima Balatro): papel claro sobre o feltro escuro. */
.banner {
  border-left-width: 3px; border-right-width: 3px;
  border-top-width: 3px; border-bottom-width: 3px;
  border-color: #f28c28;
}
.fire-btn:hover { background-color: #ffb35c; }
.tray-btn:hover { border-left-width: 6px; }
.tool-btn:hover { background-color: #54402e; }
.shop-card {
  border-left-width: 3px; border-right-width: 3px;
  border-top-width: 1px; border-bottom-width: 1px;
  border-color: #ffd23f;
}
.objective.gold { color: #ffd23f; }

/* F7 — Main menu: véu escuro full + carta central, mesmos tokens. */
.menu-open-btn {
  position: absolute; top: 16px; right: 16px;
  width: 56px; height: 56px; font-size: 28px;
  color: #f4e7d0; background-color: #3c2a1e;
  border-radius: 12px;
}
.menu-open-btn:hover { background-color: #54402e; }
.menu-root {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  align-items: center; justify-content: center;
  background-color: rgba(0, 0, 0, 0.72);
}
.menu-panel {
  width: 480px;
  background-color: #3c2a1e; border-radius: 16px;
  border-left-width: 3px; border-right-width: 3px;
  border-top-width: 3px; border-bottom-width: 3px;
  border-color: #f28c28;
  padding-left: 32px; padding-right: 32px;
  padding-top: 24px; padding-bottom: 24px;
  align-items: stretch;
}
.menu-panel Label { color: #f4e7d0; }
.menu-title {
  font-size: 64px; color: #f4e7d0;
  -unity-text-align: middle-center;
  margin-bottom: 8px;
}
.menu-btn {
  font-size: 24px; color: #2b1d14; background-color: #f28c28;
  border-radius: 12px; margin-top: 8px;
  padding-left: 24px; padding-right: 24px;
  padding-top: 10px; padding-bottom: 10px;
}
.menu-btn:hover { background-color: #ffb35c; }
.menu-btn:disabled { opacity: 0.45; }
.menu-save {
  font-size: 18px; color: #f28c28;
  -unity-text-align: middle-center; margin-top: 4px;
}
.menu-section {
  font-size: 20px; color: #f4e7d0;
  -unity-text-align: middle-center; margin-top: 16px;
}
.menu-panel Slider { margin-top: 8px; }
.menu-panel Toggle { margin-top: 8px; }

/* F7 — loja com borda dourada (banner.resultado mantém âmbar). */
.banner.shop { border-color: #ffd23f; }

/* F7 — transições suaves nos botões (120 ms, só cor). */
.fire-btn, .tool-btn, .tray-btn, .menu-btn, .menu-open-btn {
  transition-duration: 120ms;
  transition-property: background-color;
}
