/* GDD §14.1: tokens. Fundo #2B1D14, painel #3C2A1E, texto #F4E7D0, destaque #F28C28. */
.hud-root { flex-grow: 1; }
.top-left {
  position: absolute; top: 16px; left: 16px;
  background-color: #3c2a1e; border-radius: 12px;
  padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px;
}
.objective { font-size: 28px; color: #f4e7d0; }
.msg { font-size: 20px; color: #f28c28; }
.bottom-bar {
  position: absolute; bottom: 16px; left: 0; right: 0;
  flex-direction: row; justify-content: center;
  background-color: #2b1d14;
  padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;
}
.tray-btn, .tool-btn {
  font-size: 20px; color: #f4e7d0; background-color: #3c2a1e;
  border-radius: 12px; margin-left: 4px; margin-right: 4px;
  padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px;
}
.tray-btn.selected {
  background-color: #f28c28; color: #2b1d14;
}
.tray-btn:disabled, .tool-btn:disabled, .fire-btn:disabled {
  opacity: 0.45;
}
.pulse {
  border-left-width: 3px; border-right-width: 3px;
  border-top-width: 3px; border-bottom-width: 3px;
  border-color: #ffd23f;
}
.danger { color: #e05a4e; }
.tray {
  flex-direction: row;
  max-width: 900px;
}
.actions { flex-direction: row; align-items: center; }
.tool-btn.on {
  background-color: #4f9dde; color: #2b1d14;
}
.fire-btn {
  font-size: 20px; color: #2b1d14; background-color: #f28c28;
  border-radius: 12px; margin-left: 8px;
  padding-left: 24px; padding-right: 24px; padding-top: 8px; padding-bottom: 8px;
}
.banner {
  position: absolute; top: 40%; left: 30%; right: 30%;
  background-color: #3c2a1e; border-radius: 12px;
  padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px;
  align-items: center;
}
.result-text { font-size: 28px; color: #f4e7d0; }
.hidden { display: none; }

/* Cartas (draft/loja, clima Balatro): papel claro sobre o feltro escuro. */
.banner {
  border-left-width: 3px; border-right-width: 3px;
  border-top-width: 3px; border-bottom-width: 3px;
  border-color: #f28c28;
}
.fire-btn:hover { background-color: #ffb35c; }
.tray-btn:hover { border-left-width: 6px; }
.tool-btn:hover { background-color: #54402e; }
.shop-card {
  border-left-width: 3px; border-right-width: 3px;
  border-top-width: 1px; border-bottom-width: 1px;
  border-color: #ffd23f;
}
.objective.gold { color: #ffd23f; }
