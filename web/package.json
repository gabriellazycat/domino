{
  "name": "topple-web",
  "version": "1.0.0",
  "description": "TOPPLE — roguelike de dominó (remake web: Three.js + Rapier)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "desktop": "vite build && electron .",
    "dist:win": "npm run build && node scripts/package-win.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/three": "^0.170.0",
    "electron": "^38.8.6",
    "playwright": "1.49",
    "typescript": "5.6",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs"
}
